{
  "name": "motion-fx-lab",
  "version": "1.0.0",
  "private": true,
  "description": "Motion graphics as web pages, rendered frame-exact to MP4: social clips, product demos, infographics and B-roll.",
  "keywords": [
    "motion-graphics",
    "html-to-video",
    "video-rendering",
    "threejs",
    "webgl",
    "playwright",
    "ffmpeg"
  ],
  "homepage": "https://howardc38.github.io/motion-fx-lab/",
  "repository": {
    "type": "git",
    "url": "https://github.com/howardc38/motion-fx-lab.git"
  },
  "license": "0BSD",
  "scripts": {
    "render": "bash video/build.sh intro.html",
    "test:effects": "playwright test --config playwright.config.cjs",
    "record:stacks": "npm run render:stacks",
    "build:showcase": "node tools/films.cjs build showcase",
    "render:stacks": "node tools/films.cjs build stacks",
    "build:studio-assets": "node tools/build-studio-assets.cjs",
    "render:style-journey": "node tools/films.cjs build style-journey",
    "render:dot-battle": "node tools/films.cjs build dot-battle",
    "build:studio": "node tools/films.cjs build studio",
    "render:fight-effects": "node tools/films.cjs build fight-effects",
    "build:all": "node tools/films.cjs build all",
    "test:media": "playwright test tests/media.spec.cjs",
    "build:materials": "node tools/films.cjs build materials",
    "build:fluid-assets": "python3 tools/blender/build.py",
    "render:fluid-films": "node tools/films.cjs build fluid",
    "render:design-films": "node tools/films.cjs build design",
    "render:signal-films": "node tools/films.cjs build signals",
    "sync:films": "node tools/films.cjs --write",
    "check:public": "node tools/check-public.cjs",
    "test:unit": "node --test tests/*.test.mjs tests/*.test.cjs",
    "render:dialogue-films": "node tools/films.cjs build dialogue",
    "render:uses": "node tools/films.cjs build uses",
    "check:films": "node tools/films.cjs --check",
    "make:previews": "node tools/make-previews.cjs",
    "sync:fx": "node tools/fx-manifest.cjs --write",
    "check:fx": "node tools/fx-manifest.cjs --check",
    "setup:hooks": "node tools/install-hooks.cjs",
    "check:mechanical": "node tools/check-mechanical.cjs",
    "render:mechanical-films": "node tools/films.cjs build mechanical"
  },
  "devDependencies": {
    "@playwright/test": "1.59.1"
  }
}
